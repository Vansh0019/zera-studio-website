---
/**
 * The manual editor — his rule *"local free, api pe credits lgenge"*: everything that runs on the phone is free.
 * Only tools that exist in the Studio editor are listed.
 */
const tools = [
  ["Multi-track timeline", "Video, overlays, text and audio on their own tracks."],
  ["Trim, split, speed", "Frame-accurate trims, speed changes, reorder by drag."],
  ["Keyframes", "Animate position, scale, rotation and opacity over time."],
  ["Text & 200+ fonts", "Titles and captions with outlines, shadows and animations."],
  ["Music & audio", "Music tracks with fades and volume, synced to the picture."],
  ["Transitions & effects", "Dissolves, slides, flashes and shakes."],
  ["Filters & colour", "Brightness, contrast, saturation, warmth and more."],
  ["Export up to 4K 60", "480p to 4K, 24 to 60 fps, bitrate you choose."]
];

const lanes = [
  { name: "Text", clips: [[6, 22, "#c9b48a"], [40, 18, "#c9b48a"], [70, 24, "#c9b48a"]] },
  { name: "Overlay", clips: [[14, 30, "#b8643f"], [58, 20, "#3f8f9a"]] },
  { name: "Video", clips: [[0, 34, "#4a78c9"], [35, 28, "#4a78c9"], [64, 36, "#4a78c9"]] },
  { name: "Music", clips: [[0, 100, "#5a9e7c"]] }
];
---

<section id="editor" data-scene="editor" class="relative py-20 sm:py-28 lg:py-36">
  <div class="container-x">
    <div class="grid gap-6">
      <div>
        <h2 class="section-title reveal">
          A REAL EDITOR.
          <br />
          <span class="text-brand">FREE, FOREVER.</span>
        </h2>
      </div>
      <p class="body-large reveal max-w-[620px] lg:justify-self-end">
        Every AI edit opens in a full multi-track editor that runs on your phone. Change anything the AI did, or start
        from a blank timeline. Editing and export never cost credits.
      </p>
    </div>

    <div data-gate class="reveal glass mt-12 overflow-hidden rounded-2xl p-4 sm:p-6">
      <div class="tc mb-4 flex items-center justify-between pl-[76px] text-[0.65rem] text-white/40">
        <span>00:00</span><span>00:04</span><span>00:08</span><span>00:12</span><span>00:16</span>
      </div>
      <div class="relative space-y-2.5">
        {
          lanes.map((l) => (
            <div class="flex items-center gap-3">
              <span class="w-16 shrink-0 text-[0.62rem] font-semibold uppercase tracking-wide text-white/50">{l.name}</span>
              <div class="relative h-9 flex-1 overflow-hidden rounded-[4px] bg-white/[0.04]">
                {l.name === "Music" ? (
                  <div class="ed-wave absolute inset-0 flex items-center gap-[2px] px-1">
                    {Array.from({ length: 90 }).map((_, i) => (
                      <span class="w-full rounded-full bg-[#5a9e7c]/80" style={`height:${15 + ((i * 41) % 75)}%; animation-delay:${(i % 9) * 0.07}s`} />
                    ))}
                  </div>
                ) : (
                  l.clips.map(([left, width, color]) => (
                    <span
                      class="ed-clip absolute inset-y-1 rounded-[3px] border-t border-white/30"
                      style={`left:${left}%; width:${width}%; background:${color}`}
                    >
                      <span class="ed-kf absolute left-1/3 top-1/2 h-2 w-2 -translate-y-1/2 rotate-45 bg-white" />
                    </span>
                  ))
                )}
              </div>
            </div>
          ))
        }
        <div class="pointer-events-none absolute -bottom-2 -top-2 left-[76px] right-0">
          <span class="ed-playhead absolute inset-y-0 w-[2px] bg-[#ffb547]"></span>
        </div>
      </div>
    </div>

    <dl class="reveal mt-10 grid gap-x-12 border-t border-white/15 sm:grid-cols-2">
      {
        tools.map(([t, c]) => (
          <div class="flex items-baseline justify-between gap-6 border-b border-white/15 py-4">
            <dt class="font-semibold">{t}</dt>
            <dd class="m-0 max-w-[60%] text-right text-sm leading-6 text-white/55">{c}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .ed-playhead {
    animation: play 8s linear infinite;
  }
  @keyframes play {
    from {
      left: 0%;
    }
    to {
      left: 100%;
    }
  }
  .ed-wave span {
    animation: wave 0.54s ease-in-out infinite alternate;
    transform-origin: center;
  }
  @keyframes wave {
    to {
      transform: scaleY(0.45);
    }
  }
  .ed-clip {
    animation: nudge 8s var(--ease) infinite;
  }
  .ed-kf {
    animation: kf 1.07s ease-in-out infinite;
  }
  @keyframes kf {
    50% {
      transform: translateY(-50%) rotate(45deg) scale(1.5);
    }
  }
  @keyframes nudge {
    0%,
    100% {
      transform: none;
    }
    45% {
      transform: translateX(2%);
    }
    55% {
      transform: translateX(2%);
    }
  }
</style>
