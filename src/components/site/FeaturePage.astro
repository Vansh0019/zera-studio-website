---
// One feature page (`/auto-b-roll/`, `/hinglish-captions/`, …), from its entry in `features.ts`. Built for search as
// much as for people: one H1 that says the search phrase plainly, real text for every question someone typing it has,
// the app's own visuals (posters first, so the largest paint is an image, not a video), and links to every other
// feature. No loader and no WebGL here: these pages must be fast on a budget phone on 4G.
import SiteLayout from "@/layouts/SiteLayout.astro";
import Footer from "./Footer.astro";
import Faq from "./Faq.astro";
import { playUrl, siteConfig } from "@/config/site";
import { features, featureBySlug } from "./features";

type Clip = { poster: string; src: string; label: string };
interface Props {
  slug: string;
  /** The hero's visual: one clip, two clips side by side, or a still. */
  demo: { kind: "one"; clip: Clip; caption?: string } | { kind: "pair"; a: Clip; b: Clip } | { kind: "still"; src: string; alt: string };
}
const { slug, demo } = Astro.props;
const f = featureBySlug(slug);
const url = `${siteConfig.url}/${f.slug}/`;
const others = features.filter((x) => x.slug !== slug);
const firstPoster = demo.kind === "still" ? demo.src : demo.kind === "one" ? demo.clip.poster : demo.a.poster;

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${url}#page`,
      url,
      name: f.title,
      description: f.description,
      inLanguage: "en",
      isPartOf: { "@id": `${siteConfig.url}/#website` },
      about: { "@type": "SoftwareApplication", name: siteConfig.shortName, operatingSystem: "Android", applicationCategory: "MultimediaApplication", url: siteConfig.playStoreUrl },
      breadcrumb: { "@id": `${url}#breadcrumb` },
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${url}#breadcrumb`,
      itemListElement: [
        { "@type": "ListItem", position: 1, name: siteConfig.shortName, item: `${siteConfig.url}/` },
        { "@type": "ListItem", position: 2, name: f.menu, item: url },
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: f.faqs.map((q) => ({ "@type": "Question", name: q.q, acceptedAnswer: { "@type": "Answer", text: q.a } })),
    },
  ],
});
const playIcon = `<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 1.8c-.3.3-.4.7-.4 1.2v18c0 .5.1.9.4 1.2l.1.1L13.8 12.2v-.3L3.7 1.7l-.1.1Zm13.6 13.8-3.4-3.4v-.3l3.4-3.4.1.1 4 2.3c1.1.6 1.1 1.7 0 2.4l-4 2.3h-.1Zm-.1.1L13.6 12 3.6 22.2c.4.4 1 .4 1.7.1l11.8-6.6M17.1 8.3 5.3 1.6C4.6 1.2 4 1.3 3.6 1.7L13.6 12l3.5-3.7Z"/></svg>`;
---
<SiteLayout title={f.title} description={f.description} jsonLd={jsonLd} loader={false} preload={[firstPoster]}>
  <main>
    <section class="fp-hero">
      <div class="wrap fp-grid">
        <div class="fp-copy">
          <nav class="crumbs label" aria-label="Breadcrumb"><a href="/">Zera Studio</a><span aria-hidden="true">/</span><span aria-current="page">{f.menu}</span></nav>
          <h1 class="d fp-h1" data-split>{f.h1}</h1>
          <p class="lead fp-lead">{f.lead}</p>
          <div class="fp-cta">
            <a class="btn" href={playUrl(f.slug)} data-magnetic><Fragment set:html={playIcon} /><span class="roll"><span>Get it on Google Play</span><span aria-hidden="true">Get it on Google Play</span></span></a>
            <a class="btn line" href="#how"><span class="roll"><span>How it works</span><span aria-hidden="true">How it works</span></span></a>
          </div>
          <ul class="facts fp-facts">{f.facts.map(([b, t]) => <li><b>{b}</b> {t}</li>)}</ul>
        </div>

        <div class={`fp-media ${demo.kind}`}>
          {demo.kind === "still" && (
            <div class="phone"><div class="scr fp-app"><span class="fp-sb" aria-hidden="true"><b>9:41</b><i></i></span><img src={demo.src} alt={demo.alt} width="720" height="1560" fetchpriority="high" /></div></div>
          )}
          {demo.kind === "one" && (
            <figure>
              <div class="phone fit"><div class="scr">
                <video data-lazy data-src={demo.clip.src} poster={demo.clip.poster} muted playsinline loop aria-label={demo.clip.label}></video>
                {demo.caption && <span class="fp-cap" aria-hidden="true">{demo.caption.split(" ").map((w, i) => <span style={`--i:${i}`}>{w}</span>)}</span>}
              </div></div>
              <figcaption class="label">{demo.clip.label}</figcaption>
            </figure>
          )}
          {demo.kind === "pair" && [demo.a, demo.b].map((c) => (
            <figure>
              <div class="phone fit"><div class="scr"><video data-lazy data-src={c.src} poster={c.poster} muted playsinline loop aria-label={c.label}></video></div></div>
              <figcaption class="label">{c.label}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <section class="wrap fp-sec" id="how">
      <p class="chap-idx"><b>01</b><i></i><span class="label">How it works</span></p>
      <h2 class="d fp-h2" data-split>Three steps.</h2>
      <ol class="fp-steps">
        {f.steps.map((s, i) => (
          <li data-reveal data-delay={String(i * 0.08)}><span class="d fp-n">{String(i + 1).padStart(2, "0")}</span><h3 class="d-x">{s.t}</h3><p>{s.d}</p></li>
        ))}
      </ol>
    </section>

    <slot name="showcase" />

    <section class="wrap fp-sec fp-two">
      <div data-reveal>
        <p class="chap-idx"><b>02</b><i></i><span class="label">What Zera does</span></p>
        <ul class="fp-list">{f.does.map((d) => <li>{d}</li>)}</ul>
      </div>
      <div data-reveal>
        <p class="chap-idx"><b>03</b><i></i><span class="label">What stays yours</span></p>
        <ul class="fp-list">{f.yours.map((d) => <li>{d}</li>)}</ul>
      </div>
    </section>

    <section class="wrap fp-sec">
      <p class="chap-idx"><b>04</b><i></i><span class="label">Limits and cost</span></p>
      <h2 class="d fp-h2" data-split>What it takes.</h2>
      <dl class="fp-limits" data-reveal>{f.limits.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      <p class="fp-example" data-reveal><span class="hand">for example</span> {f.example}</p>
    </section>

    <section class="wrap fp-sec">
      <p class="chap-idx"><b>05</b><i></i><span class="label">Who it's for</span></p>
      <div class="fp-who">
        {f.who.map((w) => <div data-reveal><h3 class="d-x">{w.t}</h3><p>{w.d}</p></div>)}
      </div>
    </section>

    <Faq items={f.faqs} idx="06" />

    <section class="wrap fp-sec fp-more">
      <p class="chap-idx"><b>07</b><i></i><span class="label">More from Zera</span></p>
      <ul class="fp-links">
        {others.map((o) => (
          <li><a href={`/${o.slug}/`}><span class="d">{o.menu}</span><small>{o.h1}</small><i aria-hidden="true">→</i></a></li>
        ))}
        <li><a href="/"><span class="d">AI video editor</span><small>Everything Zera does, on one page</small><i aria-hidden="true">→</i></a></li>
      </ul>
    </section>
  </main>
  <Footer />
</SiteLayout>

<style>
  .fp-hero { padding: calc(var(--nav-h) + clamp(24px, 4vw, 60px)) 0 clamp(40px, 6vw, 90px); }
  .fp-grid { display: grid; gap: clamp(30px, 5vw, 80px); align-items: center; }
  .crumbs { display: flex; gap: 10px; margin-bottom: 22px; }
  .crumbs a:hover { color: var(--paper); }
  .fp-h1 { font-size: clamp(54px, 7.4vw, 140px); }
  .fp-lead { margin-top: 26px; max-width: 52ch; }
  .fp-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
  .fp-facts { margin-top: 28px; }
  .fp-media { display: flex; justify-content: center; gap: clamp(12px, 2vw, 24px); }
  .fp-media figure { display: grid; gap: 12px; justify-items: center; flex: 1; max-width: 340px; }
  .fp-media .phone { width: 100%; }
  .fp-media.pair figure:last-child { margin-top: 48px; }
  .fp-media.still .phone, .fp-media.one .phone { width: min(100%, 340px); }
  .fp-media video { position: absolute; inset: 0; }
  .fp-app { display: flex; flex-direction: column; background: #0e0e11; }
  .fp-sb { flex: none; height: 6.2%; display: flex; align-items: center; justify-content: space-between; padding: 0 9% 0 10%; font-size: 12px; color: var(--paper); }
  .fp-sb b { font-weight: 650; }
  .fp-sb i { width: 2.2em; height: 0.95em; border-radius: 3px; box-shadow: inset 0 0 0 1.2px rgba(244,244,246,0.8); }
  .fp-app img { flex: 1; min-height: 0; height: auto; object-fit: cover; object-position: center bottom; }
  .fp-cap { position: absolute; z-index: 3; left: 8%; right: 8%; bottom: 22%; text-align: center; font: 850 clamp(18px, 1.8vw, 26px)/1.1 var(--body); text-transform: uppercase; letter-spacing: -0.02em; color: #fff; text-shadow: 0 2px 12px rgba(0,0,0,0.5); }
  .fp-cap span { display: inline-block; margin: 0 0.12em; padding: 0.04em 0.16em; border-radius: 0.2em; animation: fpPop 3.2s var(--out) infinite both; animation-delay: calc(var(--i) * 0.3s); }
  @keyframes fpPop { 0% { transform: scale(0); background: var(--zera); } 8% { transform: scale(1.15); background: var(--zera); } 16% { transform: scale(1); background: var(--zera); } 26%, 86% { transform: scale(1); background: transparent; } 100% { transform: scale(0); } }

  .fp-sec { padding-top: clamp(90px, 11vw, 170px); }
  .fp-h2 { font-size: clamp(56px, 8vw, 150px); margin-top: 16px; }
  .fp-steps { list-style: none; display: grid; gap: 1px; margin-top: clamp(30px, 4vw, 60px); background: var(--line); border-radius: 22px; overflow: hidden; }
  .fp-steps li { display: grid; align-content: start; gap: 12px; padding: clamp(22px, 2.6vw, 36px); background: var(--ink-2); }
  @media (min-width: 1000px) { .fp-steps li { min-height: 260px; } }
  .fp-n { font-size: clamp(56px, 6vw, 96px); color: var(--zera-hi); }
  .fp-steps h3 { font-size: clamp(20px, 1.7vw, 28px); line-height: 1.1; }
  .fp-steps p { color: var(--muted); }

  .fp-two { display: grid; gap: clamp(40px, 5vw, 80px); }
  .fp-list { list-style: none; display: grid; gap: 0; margin-top: 22px; border-top: 1px solid var(--line); }
  .fp-list li { position: relative; padding: 18px 0 18px 30px; border-bottom: 1px solid var(--line); font-size: clamp(17px, 1.3vw, 20px); line-height: 1.45; }
  .fp-list li::before { content: ""; position: absolute; left: 4px; top: 27px; width: 9px; height: 9px; border-radius: 2px; background: var(--zera-hi); transform: rotate(45deg); }

  .fp-limits { display: grid; gap: 1px; margin-top: clamp(30px, 4vw, 50px); background: var(--line); border-radius: 20px; overflow: hidden; }
  .fp-limits div { display: grid; grid-template-columns: minmax(130px, 0.6fr) 1fr; gap: 16px; padding: 20px 22px; background: var(--ink-2); }
  .fp-limits dt { color: var(--muted); }
  .fp-limits dd { font-weight: 600; }
  .fp-example { margin-top: 22px; max-width: 70ch; font-size: clamp(17px, 1.3vw, 20px); color: var(--paper); }
  .fp-example .hand { font-size: 1.4em; margin-right: 6px; }

  .fp-who { display: grid; gap: 1px; margin-top: 26px; background: var(--line); border-radius: 22px; overflow: hidden; }
  .fp-who div { padding: 26px; background: var(--ink-2); display: grid; gap: 10px; align-content: start; }
  .fp-who h3 { font-size: clamp(20px, 1.6vw, 26px); }
  .fp-who p { color: var(--muted); }

  .fp-links { list-style: none; margin-top: 26px; border-top: 1px solid var(--line); }
  .fp-links a { display: grid; grid-template-columns: 1fr auto; grid-template-areas: "name arrow" "sub arrow"; gap: 6px 20px; align-items: center; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .fp-links .d { grid-area: name; font-size: clamp(40px, 5.4vw, 96px); transition: color 0.3s; }
  .fp-links small { grid-area: sub; color: var(--muted); font-size: 15px; }
  .fp-links i { grid-area: arrow; font-style: normal; font-size: clamp(28px, 3vw, 48px); transition: transform 0.5s var(--out); }
  @media (hover: hover) { .fp-links a:hover .d { color: var(--zera-hi); } .fp-links a:hover i { transform: translateX(10px); } }

  @media (min-width: 1000px) {
    .fp-grid { grid-template-columns: 1.15fr 1fr; }
    .fp-steps { grid-template-columns: repeat(3, 1fr); }
    .fp-two { grid-template-columns: 1fr 1fr; }
    .fp-who { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  }
</style>
