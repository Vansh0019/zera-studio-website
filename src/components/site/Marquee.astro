---
// Everything one edit does, rolling past in two rows that run against each other. Scrolling pushes them faster and
// leans them into the motion.
const items = ["B-roll", "Motion graphics", "Zooms", "Captions", "Animated text", "Transitions", "Charts"];
const star = `<svg class="mq-star" viewBox="0 0 40 40" aria-hidden="true"><path d="M20 0c1.6 9.6 6.6 15.4 20 20-13.4 4.6-18.4 10.4-20 20-1.6-9.6-6.6-15.4-20-20C13.4 15.4 18.4 9.6 20 0Z"/></svg>`;
const row = items.map((t) => `<span>${t}</span>${star}`).join("");
---
<section class="mq" aria-label="What an edit includes">
  <p class="sr">{items.join(", ")}</p>
  <div class="mq-row" data-dir="-1" aria-hidden="true"><div class="mq-track d" set:html={row + row} /></div>
  <div class="mq-row ghost" data-dir="1" aria-hidden="true"><div class="mq-track d" set:html={row + row} /></div>
</section>

<style>
  .mq { padding: clamp(40px, 6vw, 90px) 0; overflow: hidden; border-block: 1px solid var(--line); }
  .mq-row { overflow: hidden; }
  .mq-track { display: flex; align-items: center; gap: 0.32em; width: max-content; font-size: clamp(64px, 10.5vw, 200px); line-height: 1; padding: 0.04em 0; will-change: transform; }
  .mq-track :global(span) { white-space: nowrap; }
  .mq-track :global(.mq-star) { width: 0.42em; height: 0.42em; flex: none; fill: var(--zera); }
  .ghost .mq-track { color: transparent; -webkit-text-stroke: 1.5px rgba(244, 244, 246, 0.28); }
  .ghost .mq-track :global(.mq-star) { fill: none; stroke: rgba(244, 244, 246, 0.28); stroke-width: 1.5; }
</style>

<script>
  import { gsap, ScrollTrigger, reduce } from "@/scripts/site/core";
  const rows = Array.from(document.querySelectorAll<HTMLElement>(".mq-row"));
  if (!reduce) {
    let vel = 0;
    ScrollTrigger.create({ trigger: ".mq", start: "top bottom", end: "bottom top", onUpdate: (s) => { vel = s.getVelocity(); } });
    const state = rows.map((r) => ({ el: r.firstElementChild as HTMLElement, dir: Number(r.dataset.dir), x: 0, skew: gsap.quickTo(r.firstElementChild!, "skewX", { duration: 0.6, ease: "power3" }) }));
    let visible = false;
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(document.querySelector(".mq")!);
    gsap.ticker.add((_t, dt) => {
      if (!visible) return;
      vel *= 0.92;
      const boost = 1 + Math.min(Math.abs(vel) / 400, 6);
      state.forEach((s) => {
        const half = s.el.scrollWidth / 2;
        s.x += s.dir * 0.045 * dt * boost * (vel < 0 ? -1 : 1);
        if (s.x <= -half) s.x += half;
        if (s.x > 0) s.x -= half;
        gsap.set(s.el, { x: s.x });
        s.skew(gsap.utils.clamp(-12, 12, (vel / 220) * -s.dir));
      });
    });
  }
</script>
