---
// 03 · Captions. The page turns Zera blue (landonorris.com's lime moment) and ten of the app's 28 caption animations
// run live, in type, over stills from the creators' clips. Names as in the app's Animate tab. Desktop: the row is
// pinned and scrolled sideways; phones swipe it.
import { captionStyles } from "./content";
const M = "/media/site";
interface Props {
  /** Without the chapter heading and facts: a showcase on a feature page. */
  bare?: boolean;
  /** The line every card animates (the Hinglish page shows a Hinglish one). */
  line?: string;
}
const { bare = false, line = "this changed everything" } = Astro.props;
const LINE = line;
const words = LINE.split(" ");
---
<section class="chap caps" id="captions" data-flip>
  {!bare && (
  <div class="wrap chap-head caps-head">
    <p class="chap-idx"><b>03</b><i></i><span class="label">Auto captions</span></p>
    <h2 class="chap-title d" data-split>Captions<br />on every word.</h2>
    <p class="lead caps-lead" data-reveal>Word by word, right as you say it. 28 animations, any font, colour, glow and outline. English, Hindi, and Hinglish in Roman letters, the way people actually type it.</p>
    <p class="chap-links"><a class="chap-more" href="/auto-captions/">Auto captions <span aria-hidden="true">→</span></a><a class="chap-more" href="/hinglish-captions/">Hinglish captions <span aria-hidden="true">→</span></a></p>
  </div>
  )}

  <div class="hall" id="hall">
    <p class="hall-bg d" aria-hidden="true" id="hallBg">28 animations · 28 animations ·</p>
    <div class="hall-track" id="hallTrack">
      {captionStyles.map((c, n) => (
        <article class={`cap st-${c.id}`}>
          <img src={`${M}/cap_${n % 4}.webp`} alt="" loading="lazy" decoding="async" />
          <div class="cap-line" aria-label={LINE}>
            {words.map((w, wi) => (
              <span class="w" style={`--w:${wi}`}>{[...w].map((ch, ci) => <span class="c" style={`--c:${ci + wi * 7}`}>{ch}</span>)}</span>
            ))}
          </div>
          <footer><span class="label">Animate</span><b class="d-x">{c.name}</b></footer>
          <span class="cap-i num">{String(n + 1).padStart(2, "0")}</span>
        </article>
      ))}
      <article class="cap more">
        <p class="d">+18<br />more</p>
        <p>in the app's Animate tab</p>
      </article>
    </div>
  </div>
  <p class="wrap hand hall-hint" aria-hidden="true">swipe →</p>

  {!bare && (
  <div class="wrap">
    <ul class="facts caps-facts" data-reveal>
      <li><b>1 credit</b> a minute</li>
      <li><b>3 credits</b> a minute for Hinglish</li>
      <li><b>Every word</b> editable after</li>
    </ul>
  </div>
  )}
</section>

<style>
  .caps { padding-bottom: clamp(100px, 12vw, 200px); }
  .caps :global(.chap-idx b), .caps :global(.chap-title .b) { color: inherit; }
  :global(html.flip) .caps .label, :global(html.flip) .caps .lead { color: rgba(14, 14, 17, 0.72); }
  :global(html.flip) .caps .chap-idx i { background: rgba(14, 14, 17, 0.3); }
  :global(html.flip) .caps .facts li { box-shadow: inset 0 0 0 1px rgba(14, 14, 17, 0.28); color: rgba(14, 14, 17, 0.72); }
  :global(html.flip) .caps .facts li b { color: var(--ink); }
  :global(html.flip) .caps .hand { color: var(--ink); }

  .hall { position: relative; margin-top: clamp(50px, 6vw, 90px); overflow: hidden; padding-block: 3vh; }
  .hall-bg { position: absolute; top: 50%; left: 0; margin-top: -0.42em; white-space: nowrap; font-size: 34vh; color: rgba(14, 14, 17, 0.1); pointer-events: none; }
  .hall-track { position: relative; display: flex; gap: clamp(12px, 1.4vw, 22px); width: max-content; padding-inline: var(--gutter); }
  .cap { position: relative; flex: none; width: min(26vw, 47vh, 400px); aspect-ratio: 9 / 16; border-radius: 22px; overflow: hidden; background: var(--ink); box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.6); color: var(--paper); transform: translateZ(0); }
  .cap img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .cap::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(14,14,17,0.15) 0%, rgba(14,14,17,0) 40%, rgba(14,14,17,0.55) 72%, rgba(14,14,17,0.92) 100%); }
  .cap > * { position: relative; z-index: 2; }
  .cap > img { position: absolute; z-index: 0; }
  .cap-i { position: absolute; top: 14px; left: 16px; font: 600 11px/1 var(--mono); color: rgba(244,244,246,0.75); }
  .cap footer { position: absolute; left: 16px; right: 16px; bottom: 16px; display: flex; justify-content: space-between; align-items: baseline; }
  .cap footer .label { color: rgba(244,244,246,0.6); }
  .cap footer b { font-size: 22px; }

  /* the line, in the app's caption look: heavy, white, the spoken word on a blue pill */
  .cap-line { position: absolute; left: 8%; right: 8%; top: 58%; text-align: center; font: 850 clamp(24px, 2.2vw, 34px)/1.08 var(--body); text-transform: uppercase; letter-spacing: -0.02em; color: #fff; text-shadow: 0 2px 14px rgba(0,0,0,0.45); }
  .w { display: inline-block; margin: 0.04em 0.1em; padding: 0.02em 0.14em; border-radius: 0.18em; }
  .c { display: inline-block; }

  .st-pop .w { animation: pop 2.4s var(--out) infinite both; animation-delay: calc(var(--w) * 0.22s); }
  .st-pop .w { background: transparent; }
  @keyframes pop { 0% { transform: scale(0); background: var(--zera); } 12% { transform: scale(1.16); background: var(--zera); } 22% { transform: scale(1); background: var(--zera); } 34%, 82% { transform: scale(1); background: transparent; } 100% { transform: scale(0); } }
  .st-wave .c { animation: wave 1.6s ease-in-out infinite; animation-delay: calc(var(--c) * 0.055s); }
  @keyframes wave { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-0.4em); } }
  .st-type .c { animation: type 3s steps(1) infinite both; animation-delay: calc(var(--c) * 0.075s); }
  @keyframes type { 0% { opacity: 0; } 3%, 72% { opacity: 1; } 100% { opacity: 0; } }
  .st-reveal .cap-line { animation: reveal 2.6s var(--io) infinite; }
  @keyframes reveal { 0% { clip-path: inset(0 100% 0 0); } 38%, 78% { clip-path: inset(0 0 0 0); } 100% { clip-path: inset(0 0 0 100%); } }
  .st-drop .c { animation: drop 2.6s cubic-bezier(0.3, 1.6, 0.5, 1) infinite both; animation-delay: calc(var(--c) * 0.045s); }
  @keyframes drop { 0% { transform: translateY(-1.6em); opacity: 0; } 18%, 80% { transform: none; opacity: 1; } 100% { transform: translateY(0.5em); opacity: 0; } }
  .st-glow .cap-line { animation: glow 1.9s ease-in-out infinite; }
  @keyframes glow { 0%, 100% { text-shadow: 0 0 6px rgba(76,154,255,0.35); } 50% { text-shadow: 0 0 18px rgba(76,154,255,1), 0 0 42px rgba(29,116,217,0.95); } }
  .st-slide .cap-line { animation: slide 2.6s var(--out) infinite; }
  @keyframes slide { 0% { transform: translateX(-70%); opacity: 0; filter: blur(10px); } 26%, 80% { transform: none; opacity: 1; filter: none; } 100% { transform: translateX(45%); opacity: 0; filter: blur(6px); } }
  .st-bounce .w { animation: bounce 1.3s ease-in-out infinite; animation-delay: calc(var(--w) * 0.16s); }
  @keyframes bounce { 0%, 100% { transform: translateY(0); } 40% { transform: translateY(-0.45em) scale(1.06); } }
  .st-jitter .c { animation: jitter 0.28s steps(2) infinite; animation-delay: calc(var(--c) * -0.07s); }
  @keyframes jitter { 0% { transform: translate(1px, -1px) rotate(-2deg); } 50% { transform: translate(-1px, 2px) rotate(2deg); } 100% { transform: translate(2px, 0); } }

  .cap.more { display: grid; align-content: end; gap: 10px; padding: 22px; background: var(--ink); }
  .cap.more::after { display: none; }
  .cap.more .d { font-size: clamp(64px, 6vw, 110px); color: var(--zera-hi); }
  .cap.more p:last-child { color: var(--muted); font-size: 15px; }

  .hall-hint { display: none; margin-top: 14px; font-size: 24px; text-align: right; }
  .caps-facts { margin-top: clamp(40px, 5vw, 70px); }

  @media (max-width: 899px) {
    .hall { overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .hall::-webkit-scrollbar { display: none; }
    .cap { width: 68vw; scroll-snap-align: center; }
    .hall-hint { display: block; }
  }
</style>

<script>
  import { gsap, reduce } from "@/scripts/site/core";
  // Desktop: the row slides sideways while the section holds, and each card leans into the motion.
  const mm = gsap.matchMedia();
  mm.add("(min-width: 900px) and (prefers-reduced-motion: no-preference)", () => {
    const track = document.getElementById("hallTrack")!, hall = document.getElementById("hall")!;
    const dist = () => track.scrollWidth - innerWidth;
    const tween = gsap.to(track, {
      x: () => -dist(), ease: "none",
      scrollTrigger: { trigger: hall, start: "center center", end: () => `+=${dist()}`, scrub: 0.6, pin: true, invalidateOnRefresh: true, anticipatePin: 1 },
    });
    // the words behind the cards drift the other way, slower
    gsap.fromTo("#hallBg", { xPercent: -30 }, { xPercent: 0, ease: "none", scrollTrigger: { trigger: hall, start: "center center", end: () => `+=${dist()}`, scrub: 0.6, invalidateOnRefresh: true } });
    const cards = gsap.utils.toArray<HTMLElement>(".cap", track);
    const skew = gsap.quickTo(cards, "skewX", { duration: 0.5, ease: "power3" });
    const lean = () => { skew(gsap.utils.clamp(-6, 6, (tween.scrollTrigger?.getVelocity() ?? 0) / -300)); };
    gsap.ticker.add(lean);
    return () => gsap.ticker.remove(lean);
  });

  // Scramble: letters cycle through noise before they settle, like the app's Scramble. One timer, only on screen.
  const glyphs = "ABCDEFGHIJKLMNOPQRSTUVWXYZ#%&@*";
  const card = document.querySelector<HTMLElement>(".st-scramble");
  const letters = Array.from(document.querySelectorAll<HTMLElement>(".st-scramble .c")).map((el) => ({ el, real: el.textContent! }));
  if (card && !reduce) {
    let t = 0, timer = 0;
    const tick = () => {
      t = (t + 1) % 64;
      letters.forEach(({ el, real }, i) => { el.textContent = t < 6 + i * 1.3 || t > 54 ? glyphs[(Math.random() * glyphs.length) | 0] : real; });
    };
    new IntersectionObserver(([e]) => { clearInterval(timer); if (e.isIntersecting) timer = window.setInterval(tick, 45); }).observe(card);
  }
</script>
