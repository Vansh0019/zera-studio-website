---
// The FAQ: the home page's by default, or a feature page's own list.
import { faqs as homeFaqs } from "./content";
type Item = { question?: string; answer?: string; q?: string; a?: string };
interface Props { items?: Item[]; idx?: string }
const { items = homeFaqs as Item[], idx = "07" } = Astro.props;
const list = items.map((f: Item) => ({ question: f.question ?? f.q ?? "", answer: f.answer ?? f.a ?? "" }));
---
<section class="chap faq" id="faq">
  <div class="wrap faq-grid">
    <div class="chap-head faq-head">
      <p class="chap-idx"><b>{idx}</b><i></i><span class="label">FAQ</span></p>
      <h2 class="chap-title d" data-split>Questions,<br /><span class="b">answered.</span></h2>
    </div>
    <div class="faq-list">
      {list.map((f, i) => (
        <details data-reveal>
          <summary><span class="num faq-n">{String(i + 1).padStart(2, "0")}</span><span class="faq-q">{f.question}</span><i aria-hidden="true"></i></summary>
          <div class="faq-a"><p>{f.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-grid { display: grid; gap: clamp(40px, 5vw, 80px); }
  .faq-head .chap-title { font-size: clamp(64px, 8.6vw, 170px); }
  .faq-list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; display: grid; grid-template-columns: 44px 1fr 26px; gap: 12px; align-items: center; padding: 26px 0; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .faq-n { font: 600 12px/1 var(--mono); color: var(--zera-hi); }
  .faq-q { font-family: var(--display); font-weight: 650; font-stretch: 100%; font-size: clamp(20px, 1.9vw, 30px); letter-spacing: -0.025em; line-height: 1.15; transition: color 0.3s; }
  @media (hover: hover) { summary:hover .faq-q { color: var(--zera-hi); } }
  summary i { position: relative; width: 26px; height: 26px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line-2); }
  summary i::before, summary i::after { content: ""; position: absolute; top: 12px; left: 7px; width: 12px; height: 1.5px; background: var(--paper); transition: transform 0.5s var(--out); }
  summary i::after { transform: rotate(90deg); }
  details[open] summary i::after { transform: rotate(0deg); }
  .faq-a { overflow: hidden; }
  .faq-a p { padding: 0 0 28px 56px; color: var(--muted); max-width: 68ch; font-size: 17px; }
  @media (min-width: 1000px) {
    .faq-grid { grid-template-columns: 0.9fr 1.1fr; align-items: start; }
    .faq-head { position: sticky; top: calc(var(--nav-h) + 30px); }
  }
  @media (max-width: 560px) { summary { grid-template-columns: 30px 1fr 26px; } .faq-a p { padding-left: 42px; } }
</style>

<script>
  import { gsap, ScrollTrigger, reduce } from "@/scripts/site/core";
  // Smooth open and close: the answer's height is animated, and <details> only closes once it has folded.
  document.querySelectorAll<HTMLDetailsElement>(".faq details").forEach((d) => {
    const s = d.querySelector("summary")!, a = d.querySelector<HTMLElement>(".faq-a")!;
    s.addEventListener("click", (e) => {
      if (reduce) return;
      e.preventDefault();
      if (d.open) {
        gsap.to(a, { height: 0, duration: 0.5, ease: "power3.inOut", onComplete: () => { d.open = false; a.style.height = ""; ScrollTrigger.refresh(); } });
      } else {
        d.open = true;
        gsap.fromTo(a, { height: 0 }, { height: "auto", duration: 0.6, ease: "power3.out", onComplete: () => { a.style.height = ""; ScrollTrigger.refresh(); } });
      }
    });
  });
</script>
