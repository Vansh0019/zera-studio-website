---
// What Zera is, in one paragraph that lights up word by word as it is read (scrubbed by scroll), with three small
// clips set into the sentence where they belong.
const M = "/media/site";
const pill = (src: string, label: string) =>
  `<span class="pill" role="img" aria-label="${label}"><video data-lazy data-src="${M}/${src}.mp4" muted playsinline loop></video></span>`;
---
<section class="mani" id="intro">
  <div class="wrap">
    <p class="label mani-k">What Zera does</p>
    <p class="mani-t" id="maniText" set:html={
      `Zera is the AI video editor for creators who make everything on a phone. ${pill("pill_talk", "a creator talking")} Drop in a talking video. ` +
      `Zera listens to every word, then adds the B-roll ${pill("pill_broll", "a B-roll shot")}, motion graphics, zooms and captions. ` +
      `What you get back is a real timeline ${pill("pill_edit", "the finished edit")}, not a template.`
    } />
  </div>
</section>

<style>
  .mani { padding: clamp(120px, 16vw, 260px) 0 clamp(80px, 10vw, 160px); }
  .mani-k { margin-bottom: 28px; }
  .mani-t { font-family: var(--display); font-weight: 640; font-stretch: 100%; font-size: clamp(34px, 5.3vw, 108px); line-height: 1.02; letter-spacing: -0.038em; max-width: 21ch; color: var(--paper); text-wrap: pretty; }
  @media (min-width: 1000px) { .mani-k { margin-left: 0; } .mani-t { margin-left: 8.5vw; } }
  .mani-t :global(.w) { color: #3a3a45; }
  .mani-t :global(.pill) { display: inline-block; width: 2.3em; height: 0.78em; margin: 0 0.06em; border-radius: 999px; overflow: hidden; vertical-align: -0.08em; background: var(--ink-3); }
  .mani-t :global(.pill video) { width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: reduce) { .mani-t :global(.w) { color: inherit; } }
</style>

<script>
  import { gsap, SplitText, reduce } from "@/scripts/site/core";
  const el = document.getElementById("maniText")!;
  if (!reduce) {
    SplitText.create(el, {
      type: "words", wordsClass: "w", ignore: ".pill", autoSplit: true,
      onSplit: (self) => {
        // a re-split can rebuild the pills, so their clips are (re)started here
        el.querySelectorAll<HTMLVideoElement>(".pill video").forEach((v) => {
          new IntersectionObserver(([e]) => {
            if (e.isIntersecting) { if (!v.getAttribute("src")) { v.src = v.dataset.src!; v.load(); } v.play().catch(() => {}); } else v.pause();
          }, { rootMargin: "200px" }).observe(v);
        });
        const tl = gsap.timeline({ scrollTrigger: { trigger: el, start: "top 78%", end: "bottom 45%", scrub: 0.5 } });
        tl.to(self.words, { color: "#f4f4f6", stagger: 0.1, duration: 0.3, ease: "none" }, 0)
          .from(el.querySelectorAll(".pill"), { width: 0, stagger: 0.9, duration: 0.6, ease: "power2.out" }, 0.2);
        return tl;
      },
    });
  }
</script>
