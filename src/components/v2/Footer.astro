---
import { siteConfig } from "@/config/site";
const year = new Date().getFullYear();
---
<footer class="ft" data-doodle-trigger>
  <div class="wrap">
    <a class="ft-big display" href={siteConfig.playStoreUrl} data-cursor="Download">
      <span class="ft-l1">Bas bolo.</span>
      <span class="ft-l2">Baaki Zera.<svg class="doodle ft-d" viewBox="0 0 600 80" preserveAspectRatio="none" aria-hidden="true"><path d="M8 50 C 120 24, 260 64, 380 40 S 540 22, 592 44" /></svg></span>
    </a>
    <div class="ft-cta"><a class="btn" href={siteConfig.playStoreUrl}>Play Store pe lo</a><span class="hand">Android pe free hai</span></div>

    <div class="ft-cols">
      <div><p class="kicker">Contact</p><a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a><a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a><a href={`mailto:${siteConfig.feedbackEmail}`}>{siteConfig.feedbackEmail}</a></div>
      <div><p class="kicker">Follow</p><a href={siteConfig.instagram}>Instagram</a><a href={siteConfig.companyLinkedin}>LinkedIn</a><a href={siteConfig.founder.linkedin}>Founder</a></div>
      <div><p class="kicker">Legal</p><a href="/privacy-policy/">Privacy Policy</a><a href="/terms/">Terms of Service</a><a href="/account-deletion/">Account deletion</a></div>
    </div>
    <div class="ft-base"><span>© {year} {siteConfig.companyLegalName}. All rights reserved.</span><span>Made in India, for creators.</span></div>
  </div>
</footer>

<style>
  .ft { padding: clamp(120px, 18vw, 240px) 0 28px; }
  .ft-big { display: block; }
  .ft-l1, .ft-l2 { display: block; font-size: clamp(54px, 16vw, 260px); letter-spacing: -0.045em; white-space: nowrap; }
  .ft-l2 { position: relative; display: inline-block; color: var(--zera-hi); }
  .ft-d { left: 0; bottom: -0.05em; width: 100%; height: 0.22em; }
  .ft-cta { display: flex; align-items: center; gap: 18px; margin-top: 36px; flex-wrap: wrap; }
  .ft-cta .hand { font-size: 24px; }
  .ft-cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 30px; margin-top: 90px; padding-top: 30px; border-top: 1px solid var(--line); }
  .ft-cols div { display: grid; gap: 8px; align-content: start; }
  .ft-cols a { color: var(--muted); transition: color 0.2s; }
  .ft-cols a:hover { color: var(--paper); }
  .ft-cols .kicker { margin-bottom: 6px; }
  .ft-base { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px; margin-top: 60px; color: var(--dim); font-size: 13px; }
</style>
