---
// The hero: a creator's raw clip, and a lens that shows Zera's edit of the same clip wherever the cursor (or finger)
// goes. landonorris.com's reveal, pointed at what Zera does: raw → edit.
import { siteConfig } from "@/config/site";
const M = "/media/v2";
---
<section class="hero" id="top">
  <div class="hero-grid wrap">
    <div class="hero-copy">
      <p class="kicker hero-kick">AI video editor · Android</p>
      <h1 class="display hero-h">
        <span class="hl-row">Bas <span class="ul">bolo.<svg class="doodle ul-doodle" viewBox="0 0 400 40" preserveAspectRatio="none" aria-hidden="true"><path d="M6 26 C 70 14, 150 30, 222 18 S 338 10, 394 22" /></svg></span></span>
        <span class="hl-row hl-2">Baaki edit Zera karega.</span>
      </h1>
      <p class="hero-sub">Talking video daalo. Zera tumhari baat sunta hai, phir B-roll, motion graphics, zoom aur Hinglish captions khud lagata hai. Sab ek asli timeline pe.</p>
      <div class="hero-cta">
        <a class="btn" href={siteConfig.playStoreUrl}>
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.6 2.2 13.4 11 4.6 19.8a1.4 1.4 0 0 1-.6-1.2V3.4c0-.5.2-.9.6-1.2Zm10 7.6 2.5 2.5-2.5 2.4-2-2 2-2.9Zm.8-.8 3 1.7c1.1.6 1.1 2 0 2.6l-3 1.7-2.8-2.8L15.4 9ZM5.6 1.6l9 5.2-2.3 2.3L5.6 1.6Zm6.7 11.4 2.3 2.3-9 5.2 6.7-7.5Z"/></svg>
          Play Store pe lo
        </a>
        <a class="btn ghost" href="#broll">Kaise? ↓</a>
      </div>
    </div>

    <div class="hero-media" id="heroMedia" data-cursor="Zera edit">
      <video class="raw" id="heroRaw" src={`${M}/talk_raw.mp4`} poster={`${M}/talk_raw.jpg`} muted playsinline loop autoplay preload="auto" data-auto></video>
      <video class="edit" id="heroEdit" src={`${M}/talk_ai.mp4`} muted playsinline loop autoplay preload="auto" data-auto></video>
      <div class="lens-ring" id="lensRing"></div>
      <span class="hand lens-note" id="lensNote">ye Zera ka edit hai</span>
      <div class="hero-meta"><span><i></i>RAW</span><span id="heroTc">00:00:00</span></div>
      <span class="hand hint-touch">ungli ghumao →</span>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; min-height: 100svh; padding-top: 72px; overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1fr; gap: 22px; align-items: center; min-height: calc(100svh - 72px); padding-bottom: 28px; }
  .hero-kick { margin-bottom: 18px; }
  .hero-h { font-size: clamp(64px, 15.5vw, 210px); }
  .hl-row { display: block; }
  .hl-2 { font-size: 0.36em; letter-spacing: -0.03em; line-height: 1; margin-top: 0.22em; color: var(--muted); }
  .ul { position: relative; display: inline-block; }
  .ul-doodle { left: -2%; right: -2%; width: 104%; bottom: -0.04em; height: 0.24em; }
  .hero-sub { margin-top: 22px; max-width: 34ch; font-size: clamp(17px, 1.4vw, 21px); color: var(--muted); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }

  .hero-media { position: relative; order: -1; aspect-ratio: 9 / 16; width: 100%; max-height: 62svh; margin-inline: auto; border-radius: 22px; overflow: hidden; background: var(--ink-2); touch-action: pan-y; --x: 50%; --y: 42%; --r: 0px; }
  .hero-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .hero-media .edit { clip-path: circle(var(--r) at var(--x) var(--y)); }
  .lens-ring { position: absolute; left: var(--x); top: var(--y); width: calc(var(--r) * 2); height: calc(var(--r) * 2); margin: calc(var(--r) * -1) 0 0 calc(var(--r) * -1); border-radius: 50%; box-shadow: 0 0 0 2px var(--zera-hi), 0 0 40px rgba(29, 116, 217, 0.45); pointer-events: none; }
  .lens-note { position: absolute; left: 0; top: 0; white-space: nowrap; font-size: clamp(18px, 1.6vw, 24px); pointer-events: none; text-shadow: 0 2px 10px rgba(0,0,0,0.6); will-change: transform; }
  .hero-meta { position: absolute; top: 12px; left: 12px; right: 12px; display: flex; justify-content: space-between; font: 600 11px/1 ui-monospace, monospace; letter-spacing: 0.08em; pointer-events: none; }
  .hero-meta span { background: rgba(14, 14, 17, 0.6); padding: 6px 8px; border-radius: 6px; display: flex; align-items: center; gap: 6px; }
  .hero-meta i { width: 7px; height: 7px; border-radius: 50%; background: var(--rec); animation: blink 1.2s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0.2; } }
  .hint-touch { position: absolute; bottom: 14px; right: 14px; font-size: 18px; text-shadow: 0 2px 10px rgba(0,0,0,0.7); }
  @media (hover: hover) and (pointer: fine) { .hint-touch { display: none; } }

  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: 1.25fr 1fr; gap: clamp(24px, 5vw, 90px); }
    .hero-media { order: 0; max-height: calc(100svh - 120px); width: auto; height: calc(100svh - 120px); }
  }
</style>

<script>
  import { gsap, intro, reduce } from "@/scripts/v2/motion";

  const media = document.getElementById("heroMedia")!;
  const raw = document.getElementById("heroRaw") as HTMLVideoElement, edit = document.getElementById("heroEdit") as HTMLVideoElement;
  const tc = document.getElementById("heroTc")!;

  // Keep the two clips on the same frame, so the lens shows the edit of *this* moment.
  const sync = () => {
    if (Math.abs(edit.currentTime - raw.currentTime) > 0.08) edit.currentTime = raw.currentTime;
    if (!raw.paused && edit.paused) edit.play().catch(() => {});
  };
  raw.addEventListener("seeked", sync); raw.addEventListener("play", sync);
  setInterval(sync, 1000);
  const fmt = (t: number) => `00:${String(Math.floor(t)).padStart(2, "0")}:${String(Math.floor((t % 1) * 30)).padStart(2, "0")}`;
  gsap.ticker.add(() => { tc.textContent = fmt(raw.currentTime); });

  // The lens: follows the pointer over the clip; wanders on its own when nobody is steering it.
  const state = { x: 50, y: 42, r: 0 };
  // The note rides beside the lens, on whichever side has room, and never leaves the frame.
  const note = document.getElementById("lensNote")!;
  let W = 0, H = 0, nw = 0, nh = 0;
  const measure = () => { W = media.clientWidth; H = media.clientHeight; nw = note.offsetWidth; nh = note.offsetHeight; };
  const apply = () => {
    media.style.setProperty("--x", `${state.x}%`); media.style.setProperty("--y", `${state.y}%`); media.style.setProperty("--r", `${state.r}px`);
    const cx = (state.x / 100) * W, cy = (state.y / 100) * H, r = state.r;
    let nx = cx + r * 0.7, ny = cy - r * 0.95 - nh * 0.4;
    if (nx + nw > W - 10) nx = cx - r * 0.7 - nw;
    if (ny < 40) ny = cy + r * 0.85;
    nx = Math.max(10, Math.min(W - nw - 10, nx)); ny = Math.max(40, Math.min(H - nh - 10, ny));
    note.style.transform = `translate(${nx}px, ${ny}px)`;
  };
  measure();
  document.fonts.ready.then(measure);
  let steering = 0, t0 = performance.now();
  const radius = () => Math.min(media.clientWidth, media.clientHeight) * 0.3;
  const toPct = (e: PointerEvent) => { const b = media.getBoundingClientRect(); return { x: ((e.clientX - b.left) / b.width) * 100, y: ((e.clientY - b.top) / b.height) * 100 }; };
  media.addEventListener("pointermove", (e) => { steering = performance.now(); const p = toPct(e); gsap.to(state, { x: p.x, y: p.y, duration: 0.5, ease: "power3", onUpdate: apply }); });
  media.addEventListener("pointerdown", (e) => { steering = performance.now(); const p = toPct(e); gsap.to(state, { x: p.x, y: p.y, duration: 0.45, ease: "power3", onUpdate: apply }); });
  gsap.ticker.add(() => {
    if (performance.now() - steering < 2500 || reduce) return;
    const t = (performance.now() - t0) / 1000;
    state.x += ((50 + Math.sin(t * 0.7) * 26) - state.x) * 0.04;
    state.y += ((42 + Math.sin(t * 1.1 + 1) * 16) - state.y) * 0.04;
    apply();
  });

  // Entrance, after the loader.
  intro.add(() => {
    gsap.to(state, { r: radius(), duration: 1.2, ease: "expo.out", delay: 0.25, onUpdate: apply });
    if (!reduce) gsap.from(".hero-h .hl-row, .hero-sub, .hero-cta, .hero-kick", { y: 60, opacity: 0, duration: 1.1, ease: "expo.out", stagger: 0.08 });
  });
  addEventListener("resize", () => { measure(); state.r = radius(); apply(); });
</script>
