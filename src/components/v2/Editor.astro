---
// The manual editor: a timeline drawn in the page, scrubbed by scroll, beside the clip it plays. Only features the app
// has and he has accepted on his phone: keyframes, masking, filters & adjust, overlays, transitions, speed, text
// styles and animations, music with waveform, crop.
const M = "/media/v2";
const tracks = [
  { name: "Video", color: "#3a3a46", clips: [[0, 26], [27, 52], [53, 80], [81, 100]] },
  { name: "Text", color: "#1d74d9", clips: [[6, 30], [44, 70]] },
  { name: "Effects", color: "#7a5af8", clips: [[22, 34], [60, 72]] },
  { name: "Overlay", color: "#0ea5a3", clips: [[34, 58]] },
  { name: "Music", color: "#2a2a33", clips: [[0, 100]], wave: true },
];
const keys = [12, 40, 66, 88];
const features = ["Keyframes", "Masking", "Filters & adjust", "Overlays, PiP", "Transitions", "Speed 0.25–4×", "Text, 28 animations", "Music + waveform", "Crop & frame"];
---
<section class="ch" id="editor">
  <div class="wrap ch-head">
    <p class="kicker">Full editor · free</p>
    <h2 class="display ch-title" data-split>Jo AI na kare,<br /><em>wo tum khud.</em></h2>
  </div>

  <div class="ed" id="ed">
    <div class="ed-mon" data-cursor="Editor">
      <video data-lazy data-src={`${M}/selfie_ai.mp4`} poster={`${M}/selfie_ai.jpg`} muted playsinline loop></video>
      <span class="ed-tc" id="edTc">00:00:00</span>
    </div>
    <div class="ed-tl" aria-hidden="true">
      <div class="ed-ruler">{Array.from({ length: 11 }, (_, i) => <span>{`0:${String(i).padStart(2, "0")}`}</span>)}</div>
      {tracks.map((t) => (
        <div class="ed-row">
          <span class="ed-name">{t.name}</span>
          <div class="ed-lane">
            {t.clips.map(([a, b]) => (
              <i class={`ed-clip ${t.wave ? "wave" : ""}`} style={`left:${a}%;width:${b - a}%;--c:${t.color}`}></i>
            ))}
            {t.name === "Video" && keys.map((k) => <b class="ed-key" style={`left:${k}%`}></b>)}
          </div>
        </div>
      ))}
      <div class="ed-head" id="edHead"><i></i></div>
    </div>
  </div>

  <div class="wrap ed-foot" data-rise>
    <ul class="ed-feats">{features.map((f) => <li>{f}</li>)}</ul>
    <p class="ch-foot">Har AI edit isi editor me khulta hai. Editor aur export hamesha free hain.</p>
  </div>
</section>

<style>
  .ed { display: grid; grid-template-columns: 1fr; gap: 18px; margin: clamp(40px, 6vw, 80px) auto 0; padding-inline: var(--gutter); max-width: 1300px; }
  .ed-mon { position: relative; width: min(340px, 70vw); aspect-ratio: 9 / 16; margin-inline: auto; border-radius: 18px; overflow: hidden; background: var(--ink-2); box-shadow: 0 0 0 1px var(--line); }
  .ed-mon video { width: 100%; height: 100%; object-fit: cover; }
  .ed-tc { position: absolute; top: 10px; right: 10px; font: 600 11px/1 ui-monospace, monospace; background: rgba(14,14,17,0.7); padding: 6px 8px; border-radius: 6px; }
  .ed-tl { position: relative; background: var(--ink-2); border-radius: 18px; padding: 14px 14px 16px; box-shadow: 0 0 0 1px var(--line); overflow: hidden; }
  .ed-ruler { display: flex; justify-content: space-between; margin-left: 72px; font: 500 10px/1 ui-monospace, monospace; color: var(--dim); margin-bottom: 10px; }
  .ed-row { display: grid; grid-template-columns: 64px 1fr; gap: 8px; align-items: center; margin-top: 8px; }
  .ed-name { font-size: 12px; color: var(--muted); }
  .ed-lane { position: relative; height: 34px; border-radius: 8px; background: var(--ink); }
  .ed-clip { position: absolute; top: 3px; bottom: 3px; border-radius: 6px; background: var(--c); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.08); transform-origin: left; }
  .ed-clip.wave { background: repeating-linear-gradient(90deg, #4a4a58 0 2px, transparent 2px 5px), var(--c); background-size: 100% 60%, auto; background-position: center; background-repeat: repeat-x; }
  .ed-key { position: absolute; top: 50%; width: 11px; height: 11px; margin: -5.5px 0 0 -5.5px; background: #fff; transform: rotate(45deg) scale(0); border-radius: 2px; box-shadow: 0 0 0 2px var(--ink); }
  .ed-key.on { transform: rotate(45deg) scale(1); transition: transform 0.3s cubic-bezier(.3,1.8,.5,1); }
  .ed-head { position: absolute; top: 6px; bottom: 6px; left: calc(14px + 72px); width: 0; }
  .ed-head i { position: absolute; top: 0; bottom: 0; left: -1px; width: 2px; background: var(--paper); }
  .ed-head i::before { content: ""; position: absolute; top: 0; left: -6px; width: 14px; height: 14px; background: var(--paper); clip-path: polygon(0 0, 100% 0, 50% 100%); }
  .ed-foot { max-width: 1300px; }
  .ed-feats { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; list-style: none; }
  .ed-feats li { padding: 10px 14px; border-radius: 999px; box-shadow: inset 0 0 0 1px var(--line); font-weight: 600; font-size: 15px; }
  @media (max-width: 899px) { .ed-ruler span:nth-child(even) { visibility: hidden; } }
  @media (min-width: 900px) { .ed { grid-template-columns: 340px 1fr; align-items: center; } .ed-name { font-size: 13px; } .ed-lane { height: 42px; } }
</style>

<script>
  import { gsap, reduce } from "@/scripts/v2/motion";
  const ed = document.getElementById("ed")!, head = document.getElementById("edHead")!, tc = document.getElementById("edTc")!;
  const lane = ed.querySelector<HTMLElement>(".ed-lane")!;
  const keys = Array.from(ed.querySelectorAll<HTMLElement>(".ed-key"));
  const place = (p: number) => {
    const w = lane.clientWidth;
    head.style.transform = `translateX(${p * w}px)`;
    const s = p * 10;
    tc.textContent = `00:${String(Math.floor(s)).padStart(2, "0")}:${String(Math.floor((s % 1) * 30)).padStart(2, "0")}`;
    keys.forEach((k) => k.classList.toggle("on", parseFloat(k.style.left) / 100 <= p + 0.001));
  };
  if (reduce) place(1);
  else {
    gsap.from(".ed-clip", { scaleX: 0, duration: 0.9, ease: "expo.out", stagger: 0.04, scrollTrigger: { trigger: ed, start: "top 80%", once: true } });
    const o = { p: 0 };
    gsap.to(o, { p: 1, ease: "none", onUpdate: () => place(o.p), scrollTrigger: { trigger: ed, start: "top 70%", end: "bottom 30%", scrub: 0.4 } });
  }
</script>
