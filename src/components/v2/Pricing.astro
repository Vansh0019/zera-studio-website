---
// Plans and credits, as large rows rather than a card grid. Numbers come from config (the server's own).
import { pricing, siteConfig } from "@/config/site";
import { plans } from "./content";
---
<section class="ch" id="pricing">
  <div class="wrap ch-head">
    <p class="kicker">Pricing</p>
    <h2 class="display ch-title" data-split>Editor free.<br /><em>AI pe credits.</em></h2>
  </div>

  <div class="wrap pr">
    {plans.map((p) => (
      <a class={`pr-row ${p.hot ? "hot" : ""}`} href={siteConfig.playStoreUrl} data-rise data-cursor={p.cta}>
        <span class="pr-name display">{p.name}</span>
        <span class="pr-lines">{p.lines.map((l) => <span>{l}</span>)}</span>
        <span class="pr-price display">{p.price}<small>{p.per}</small></span>
      </a>
    ))}
  </div>

  <div class="wrap costs" data-rise>
    <p class="kicker">Credits per feature</p>
    <dl>
      {pricing.costs.map((c) => (<div><dt>{c.feature}</dt><dd><b>{c.amount}</b> {c.unit}</dd></div>))}
    </dl>
    <p class="costs-note">Price start se pehle dikhta hai. Run fail hua, to credits wapas. Prices Google Play ke India prices hain; doosre deshon me Play local price dikhata hai.</p>
  </div>
</section>

<style>
  .pr { margin-top: clamp(30px, 5vw, 70px); border-top: 1px solid var(--line); }
  .pr-row { display: grid; grid-template-columns: 1fr auto; grid-template-areas: "name price" "lines lines"; gap: 10px 20px; align-items: baseline; padding: clamp(22px, 3vw, 36px) 0; border-bottom: 1px solid var(--line); transition: padding 0.4s var(--ease), color 0.3s; }
  .pr-row:hover { padding-left: 14px; }
  .pr-row:hover .pr-name { color: var(--zera-hi); }
  .pr-name { grid-area: name; font-size: clamp(48px, 9vw, 130px); transition: color 0.3s; }
  .pr-price { grid-area: price; font-size: clamp(36px, 6vw, 90px); text-align: right; }
  .pr-price small { font-family: var(--body); font-size: 15px; font-weight: 500; color: var(--muted); letter-spacing: 0; margin-left: 6px; }
  .pr-lines { grid-area: lines; display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--muted); font-size: 16px; }
  .hot .pr-name::after { content: "zyada credits"; font-family: var(--hand); font-size: 0.22em; color: var(--zera-hi); letter-spacing: 0; margin-left: 0.4em; vertical-align: super; }
  @media (min-width: 900px) { .pr-row { grid-template-columns: 1.1fr 1.2fr auto; grid-template-areas: "name lines price"; align-items: center; } .pr-lines { flex-direction: column; } }
  .costs { margin-top: 50px; max-width: 900px; }
  .costs dl { margin-top: 16px; display: grid; gap: 1px; background: var(--line); border-radius: 14px; overflow: hidden; }
  .costs dl div { display: flex; justify-content: space-between; gap: 16px; padding: 14px 16px; background: var(--ink-2); }
  .costs dt { color: var(--muted); }
  .costs dd { white-space: nowrap; }
  .costs dd b { font-family: var(--display); font-size: 20px; }
  .costs-note { margin-top: 14px; color: var(--dim); font-size: 14px; max-width: 70ch; }
</style>
