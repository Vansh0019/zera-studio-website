---
// Reference to edit: a reel plays on the left; on the right your clips cut on the same rhythm, live. The point of the
// feature, shown rather than told. Facts: reference up to 6 min, clips up to 30 min, 5 credits an edit.
const M = "/media/v2";
const mine = ["mine_a", "mine_b", "mine_c", "mine_d"];
---
<section class="ch" id="reference">
  <div class="wrap ch-head">
    <p class="kicker">Reference to edit</p>
    <h2 class="display ch-title" data-split>Koi bhi reel.<br /><em>Uska style.</em><br />Tumhari clips.</h2>
  </div>

  <div class="wrap ref" id="ref" data-doodle-trigger>
    <figure class="ref-f">
      <video data-lazy data-src={`${M}/ref_a.mp4`} poster={`${M}/ref_a.jpg`} muted playsinline loop></video>
      <figcaption><span class="kicker">Reference reel</span></figcaption>
    </figure>

    <div class="ref-mid">
      <span class="hand">same cuts, <br />same beat</span>
      <svg class="doodle ref-arrow" viewBox="0 0 200 60" aria-hidden="true"><path d="M8 34 C 50 14, 120 50, 180 28 M164 16 L 184 27 L 166 42" /></svg>
    </div>

    <figure class="ref-f mine" id="refMine" data-cursor="Your clips">
      {mine.map((m, i) => (<video data-src={`${M}/${m}.mp4`} poster={`${M}/${m}.jpg`} muted playsinline loop class={i === 0 ? "on" : ""}></video>))}
      <div class="cutflash" id="cutFlash"></div>
      <figcaption><span class="kicker">Tumhari clips, Zera ka edit</span></figcaption>
    </figure>
  </div>

  <div class="wrap"><div class="beatline" id="beatline" aria-hidden="true">{Array.from({ length: 16 }, (_, i) => <i class={i % 4 === 0 ? "mark" : ""}></i>)}</div></div>
  <div class="wrap" data-rise><p class="ch-foot">Jo reel pasand aaye wo do, apni clips do. Zera uske cuts, beats, transitions aur pacing padhta hai, aur tumhari footage se wahi edit banata hai, editor me khula, sab badal sakte ho. Reference 6 minute tak, clips 30 minute tak. 5 credits per edit.</p></div>
</section>

<style>
  .ref { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: clamp(10px, 3vw, 40px); margin-top: clamp(40px, 6vw, 80px); max-width: 1100px; }
  .ref-f { position: relative; aspect-ratio: 9 / 16; border-radius: 20px; overflow: hidden; background: var(--ink-2); box-shadow: 0 0 0 1px var(--line); }
  .ref-f video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .mine video { opacity: 0; }
  .mine video.on { opacity: 1; }
  .ref-f figcaption { position: absolute; left: 10px; bottom: 10px; background: rgba(14,14,17,0.7); padding: 7px 9px; border-radius: 7px; }
  .ref-f figcaption .kicker { color: var(--paper); }
  .cutflash { position: absolute; inset: 0; background: var(--zera); opacity: 0; pointer-events: none; mix-blend-mode: screen; }
  .ref-mid { position: relative; display: grid; justify-items: center; gap: 8px; text-align: center; }
  .ref-mid .hand { font-size: clamp(18px, 2.2vw, 30px); line-height: 1; }
  .ref-arrow { position: relative; width: clamp(60px, 9vw, 140px); }
  .beatline { display: grid; grid-template-columns: repeat(16, 1fr); gap: 6px; margin: 26px auto 0; max-width: calc(1100px - 2 * var(--gutter)); }
  .beatline i { height: 10px; border-radius: 3px; background: var(--ink-3); transition: background 0.1s; }
  .beatline i.mark { background: rgba(29, 116, 217, 0.35); }
  .beatline i.on { background: var(--paper); }
  .beatline i.mark.on { background: var(--zera-hi); }
  @media (max-width: 640px) {
    .ref { grid-template-columns: 1fr 1fr; }
    .ref-mid { grid-column: 1 / -1; grid-row: 1; display: flex; justify-content: center; align-items: center; gap: 12px; }
    .ref-mid br { display: none; }
    .ref-arrow { width: 70px; }
  }
</style>

<script>
  import { gsap } from "@/scripts/v2/motion";
  // Your clips cut on the reference's rhythm: one step every eighth note at 96 BPM, a cut every two beats (the marked
  // ticks).
  const mine = Array.from(document.querySelectorAll<HTMLVideoElement>("#refMine video"));
  const ticks = Array.from(document.querySelectorAll<HTMLElement>("#beatline i"));
  const flash = document.getElementById("cutFlash")!;
  const ref = document.getElementById("ref")!;
  const STEP = 60 / 96 / 2;
  let step = 0, clip = 0, visible = false, last = 0;
  // Only the clip on screen plays (with the reference, two decoders): four looping at once is too much for a budget
  // phone. The others load once, so a cut never waits on the network.
  new IntersectionObserver(([e]) => {
    visible = e.isIntersecting;
    mine.forEach((v) => { if (visible && !v.src) { v.src = v.dataset.src!; v.load(); } });
    visible ? mine[clip].play().catch(() => {}) : mine.forEach((v) => v.pause());
  }, { rootMargin: "200px" }).observe(ref);
  gsap.ticker.add((time) => {
    if (!visible || time - last < STEP) return;
    last = time;
    ticks.forEach((t, i) => t.classList.toggle("on", i === step));
    if (step % 4 === 0) {
      const prev = mine[clip];
      clip = (clip + 1) % mine.length;
      mine[clip].play().catch(() => {});
      mine[clip].classList.add("on");
      prev.classList.remove("on");
      prev.pause();
      gsap.fromTo(flash, { opacity: 0.55 }, { opacity: 0, duration: 0.25, ease: "power2.out" });
    }
    step = (step + 1) % 16;
  });
</script>
