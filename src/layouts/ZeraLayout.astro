---
// v2 layout (2026-10-13): the loader, the nav and its full-screen menu, the grain, the cursor and the motion runtime.
// SEO tags are the same as BaseLayout's, so search and link previews keep working unchanged.
import { siteConfig } from "@/config/site";
import "@fontsource-variable/inter";
import "@fontsource-variable/bricolage-grotesque/wdth.css";
import "@fontsource/kalam/400.css";
import "@fontsource/kalam/700.css";
import "@/styles/v2.css";

interface Props {
  title?: string;
  description?: string;
  jsonLd?: string;
}
const { title = `${siteConfig.shortName} — AI Video Editor for Creators`, description = siteConfig.description, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, siteConfig.url).toString();
const ogImageUrl = `${siteConfig.url}${siteConfig.ogImage}`;
const links = [
  { label: "AI B-roll", href: "#broll" },
  { label: "Reference", href: "#reference" },
  { label: "Captions", href: "#captions" },
  { label: "Editor", href: "#editor" },
  { label: "Pricing", href: "#pricing" },
  { label: "FAQ", href: "#faq" },
];
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={siteConfig.companyLegalName} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:site_name" content={siteConfig.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.shortName} — AI Video Editor for Creators`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#0e0e11" />
    <link rel="preload" as="image" href="/media/v2/talk_raw.jpg" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <script is:inline>
      // The loader plays once per visit, and never for reduced motion. Decided before first paint so it never flashes.
      try {
        if (sessionStorage.getItem("zera-loaded") || matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("no-loader");
      } catch (e) { document.documentElement.classList.add("no-loader"); }
    </script>
  </head>
  <body>
    <div class="loader" id="loader" aria-hidden="true">
      <div class="ld-top"><span class="kicker">Load Zera</span><span class="kicker" id="ldPct">0%</span></div>
      <div class="ld-tc display" id="ldTc">00:00:00</div>
      <div class="ld-track"><i id="ldBar"></i><b id="ldHead"></b></div>
      <div class="ld-half ld-a"></div><div class="ld-half ld-b"></div>
    </div>

    <header class="nav" id="nav">
      <a href="/" class="brand" aria-label="Zera Studio home"><img src="/media/logo-96.png" alt="" width="28" height="28" /><span>zera</span></a>
      <div class="nav-r">
        <a class="nav-get" href={siteConfig.playStoreUrl}>Get the app</a>
        <button class="burger" id="burger" aria-label="Menu" aria-expanded="false"><i></i><i></i></button>
      </div>
    </header>

    <div class="menu" id="menu" hidden>
      <nav>
        {links.map((l, i) => (<a href={l.href} class="menu-link display" style={`--i:${i}`}>{l.label}</a>))}
      </nav>
      <div class="menu-foot">
        <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
        <a href={siteConfig.instagram}>Instagram</a>
        <a href={siteConfig.companyLinkedin}>LinkedIn</a>
      </div>
    </div>

    <div class="cursor" id="cursor" aria-hidden="true"><span id="cursorLabel"></span></div>
    <div class="grain" aria-hidden="true"></div>

    <slot />

    <style is:global>
      .loader { position: fixed; inset: 0; z-index: 200; background: var(--ink); display: grid; place-content: center; gap: 22px; padding: var(--gutter); }
      html.no-loader .loader { display: none; }
      .ld-top { position: absolute; top: 18px; left: var(--gutter); right: var(--gutter); display: flex; justify-content: space-between; }
      .ld-tc { font-size: clamp(56px, 16vw, 200px); font-variant-numeric: tabular-nums; letter-spacing: -0.04em; }
      .ld-track { position: relative; height: 2px; background: var(--line); width: min(70vw, 760px); margin: 0 auto; }
      .ld-track i { position: absolute; inset: 0; transform-origin: left; transform: scaleX(0); background: var(--zera); }
      .ld-track b { position: absolute; top: -9px; left: 0; width: 2px; height: 20px; background: var(--paper); }
      .ld-half { position: absolute; left: 0; right: 0; height: 50%; background: var(--ink); z-index: -1; }
      .ld-a { top: 0; } .ld-b { bottom: 0; }

      .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 60; display: flex; justify-content: space-between; align-items: center; padding: 14px var(--gutter); mix-blend-mode: difference; transition: transform 0.5s var(--ease); }
      .nav.tuck { transform: translateY(-100%); }
      .brand { display: flex; align-items: center; gap: 8px; font-family: var(--display); font-weight: 800; font-size: 22px; letter-spacing: -0.04em; }
      .brand img { border-radius: 7px; }
      .nav-r { display: flex; align-items: center; gap: 14px; }
      .nav-get { font-weight: 700; font-size: 14px; padding: 9px 14px; border-radius: 999px; box-shadow: inset 0 0 0 1.5px var(--paper); }
      .burger { width: 40px; height: 40px; display: grid; place-content: center; gap: 6px; }
      .burger i { display: block; width: 24px; height: 2px; background: var(--paper); transition: transform 0.4s var(--ease); }
      .burger[aria-expanded="true"] i:first-child { transform: translateY(4px) rotate(45deg); }
      .burger[aria-expanded="true"] i:last-child { transform: translateY(-4px) rotate(-45deg); }

      .menu { position: fixed; inset: 0; z-index: 55; background: var(--ink-2); display: flex; flex-direction: column; justify-content: space-between; padding: 90px var(--gutter) 28px; clip-path: inset(0 0 100% 0); transition: clip-path 0.6s var(--ease); }
      .menu.open { clip-path: inset(0 0 0 0); }
      .menu nav { display: grid; gap: 4px; }
      .menu-link { font-size: clamp(44px, 12vw, 120px); transform: translateY(40px); opacity: 0; transition: transform 0.6s var(--ease), opacity 0.6s, color 0.2s; transition-delay: calc(var(--i) * 40ms + 120ms); }
      .menu.open .menu-link { transform: none; opacity: 1; }
      .menu-link:hover { color: var(--zera-hi); }
      .menu-foot { display: flex; flex-wrap: wrap; gap: 18px; color: var(--muted); font-size: 15px; }

      .cursor { position: fixed; top: 0; left: 0; z-index: 120; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: var(--paper); pointer-events: none; mix-blend-mode: difference; transition: width 0.3s var(--ease), height 0.3s var(--ease), margin 0.3s var(--ease); display: none; }
      .cursor span { position: absolute; inset: 0; display: grid; place-items: center; font: 700 12px/1 var(--body); color: var(--ink); opacity: 0; }
      .cursor.big { width: 84px; height: 84px; margin: -42px 0 0 -42px; mix-blend-mode: normal; background: var(--zera); }
      .cursor.big span { opacity: 1; color: #fff; }
      @media (hover: hover) and (pointer: fine) { .cursor { display: block; } }
    </style>

    <script>
      import "@/scripts/v2/motion";
    </script>
  </body>
</html>
