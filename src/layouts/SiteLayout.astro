---
// The site's layout (2026-10-13): loader (home only), nav, full-screen menu and the motion runtime. SEO tags match
// BaseLayout's, so search results and link previews keep working unchanged.
import { playUrl, siteConfig } from "@/config/site";
import Beacon from "@/components/Beacon.astro";
import { features } from "@/components/site/features";
import "@fontsource-variable/inter";
import "@fontsource-variable/mona-sans/wdth.css";
import "@fontsource/caveat/600.css";
import "@/styles/site.css";

interface Props {
  title?: string;
  description?: string;
  jsonLd?: string;
  preload?: string[];
  /** The counting loader is the home page's entrance; inner pages open straight away. */
  loader?: boolean;
}
const { title = `${siteConfig.shortName} — AI Video Editor for Creators`, description = siteConfig.description, jsonLd, preload = [], loader = true } = Astro.props;
const isHome = Astro.url.pathname === "/";
const canonical = new URL(Astro.url.pathname, siteConfig.url).toString();
const ogImageUrl = `${siteConfig.url}${siteConfig.ogImage}`;
// The menu leads to the feature pages from everywhere (they carry the detail, and every page linking to them is how
// search engines learn they matter); pricing and the FAQ live on the home page.
const links = [
  ...features.map((f) => ({ label: f.menu, href: `/${f.slug}/` })),
  { label: "Pricing", href: isHome ? "#pricing" : "/#pricing" },
  { label: "FAQ", href: isHome ? "#faq" : "/#faq" },
];
const roll = (t: string) => `<span>${t}</span><span aria-hidden="true">${t}</span>`;
---
<!doctype html>
<html lang="en" data-loader={loader ? "on" : "off"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={siteConfig.companyLegalName} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={siteConfig.shortName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteConfig.shortName} — AI Video Editor for Creators`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="theme-color" content="#0e0e11" />
    {preload.map((href) => <link rel="preload" as="image" href={href} />)}
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
    <script is:inline>
      // The loader plays once per visit and never for reduced motion; decided before first paint so it never flashes.
      try {
        if (document.documentElement.dataset.loader === "off" || sessionStorage.getItem("zera-loaded") || matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("no-loader");
      } catch (e) { document.documentElement.classList.add("no-loader"); }
    </script>
  </head>
  <body>
{loader && (
    <div class="loader" id="loader" aria-hidden="true">
      <div class="ld-row"><span class="label">Zera Studio</span><span class="label">Loading the edit</span></div>
      <div class="ld-num d"><span id="ldNum">0</span></div>
      <div class="ld-bar"><i id="ldBar"></i></div>
      <div class="ld-sweep" id="ldSweep"></div>
    </div>
)}

    <header class="nav" id="nav">
      <a href="/" class="brand" aria-label="Zera Studio home">
        <img src="/media/logo-96.png" alt="" width="20" height="30" />
        <span class="d-x">Zera</span>
      </a>
      <div class="nav-r">
        <a class="btn nav-get" href={playUrl("nav")} data-magnetic><span class="roll" set:html={roll("Get the app")} /></a>
        <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="menu">
          <span class="burger-t roll" set:html={roll("Menu")} /><span class="burger-i"><i></i><i></i></span>
        </button>
      </div>
    </header>

    <div class="menu" id="menu" hidden>
      <div class="menu-in wrap">
        <nav class="menu-nav" aria-label="Sections">
          {links.map((l, i) => (
            <a href={l.href} class="menu-link d" style={`--i:${i}`}><small class="label">{String(i + 1).padStart(2, "0")}</small><span>{l.label}</span></a>
          ))}
        </nav>
        <div class="menu-side">
          <div class="phone fit menu-phone"><div class="scr"><video data-lazy data-src="/media/site/hero_edit_m.mp4" muted playsinline loop poster="/media/site/hero_edit.webp"></video></div></div>
        </div>
        <div class="menu-foot">
          <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
          <a href={siteConfig.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={siteConfig.companyLinkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={playUrl("menu")}>Google Play</a>
        </div>
      </div>
    </div>


    <slot />
    <Beacon />

    <style is:global>
      /* loader */
      .loader { position: fixed; inset: 0; z-index: 200; background: var(--ink); padding: 22px var(--gutter); display: grid; grid-template-rows: auto 1fr auto; }
      html.no-loader .loader { display: none; }
      .ld-row { display: flex; justify-content: space-between; }
      .ld-num { align-self: end; font-size: clamp(120px, 30vw, 520px); line-height: 0.78; overflow: hidden; padding-top: 0.04em; }
      .ld-num span { display: inline-block; }
      .ld-bar { position: relative; height: 2px; margin-top: 18px; background: var(--line); }
      .ld-bar i { position: absolute; inset: 0; transform-origin: left; transform: scaleX(0); background: var(--zera); }
      .ld-sweep { position: absolute; inset: 0; background: var(--zera); transform: translateY(100%); }

      /* nav */
      .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 80; height: var(--nav-h); padding: 0 var(--gutter); display: flex; align-items: center; justify-content: space-between; transition: transform 0.6s var(--out), background-color 0.4s, backdrop-filter 0.4s; }
      .nav.solid { background: color-mix(in srgb, var(--bg) 72%, transparent); backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); }
      .nav.tuck { transform: translateY(-100%); }
      .brand { display: flex; align-items: center; gap: 10px; font-size: 19px; color: var(--fg); }
      .brand img { border-radius: 8px; }
      .nav-r { display: flex; align-items: center; gap: 10px; }
      .nav-get { --h: 44px; padding: 0 18px; font-size: 14.5px; }
      .burger { display: flex; align-items: center; gap: 12px; height: 44px; padding: 0 6px 0 16px; border-radius: 999px; font-weight: 600; font-size: 14.5px; color: var(--fg); }
      .burger .roll { position: relative; overflow: hidden; height: 1.3em; line-height: 1.3em; }
      .burger .roll > span { display: block; transition: transform 0.55s var(--out); }
      .burger .roll > span + span { position: absolute; inset: 100% 0 auto; }
      .burger:hover .roll > span { transform: translateY(-100%); }
      .burger-i { position: relative; width: 36px; height: 36px; border-radius: 50%; box-shadow: inset 0 0 0 1px var(--line-2); display: grid; place-content: center; gap: 5px; }
      .burger-i i { display: block; width: 14px; height: 1.5px; background: currentColor; transition: transform 0.5s var(--out); }
      .burger[aria-expanded="true"] .burger-i i:first-child { transform: translateY(3.25px) rotate(45deg); }
      .burger[aria-expanded="true"] .burger-i i:last-child { transform: translateY(-3.25px) rotate(-45deg); }
      @media (max-width: 560px) { .burger-t { display: none; } .burger { padding: 0; } .nav-get { padding: 0 15px; } }

      /* menu */
      .menu { position: fixed; inset: 0; z-index: 70; background: var(--ink-2); clip-path: inset(0 0 100% 0); transition: clip-path 0.8s var(--io); overflow: auto; }
      .menu.open { clip-path: inset(0 0 0 0); }
      .menu-in { min-height: 100%; display: grid; grid-template-columns: 1fr; grid-template-rows: 1fr auto; gap: 30px; padding-top: calc(var(--nav-h) + 24px); padding-bottom: 26px; }
      .menu-nav { display: grid; align-content: center; }
      .menu-link { display: flex; align-items: baseline; gap: 14px; font-size: clamp(52px, 9.5vw, 150px); padding: 0.02em 0; color: var(--paper); transform: translateY(70%); opacity: 0; transition: transform 0.9s var(--out), opacity 0.6s, color 0.3s; transition-delay: 0s; }
      .menu.open .menu-link { transform: none; opacity: 1; transition-delay: calc(var(--i) * 45ms + 260ms); }
      .menu-link small { color: var(--zera-hi); min-width: 2.4em; }
      .menu-nav:hover .menu-link { color: var(--dim); }
      .menu-nav .menu-link:hover { color: var(--paper); }
      .menu-side { display: none; }
      .menu-foot { display: flex; flex-wrap: wrap; gap: 10px 26px; color: var(--muted); font-size: 15px; border-top: 1px solid var(--line); padding-top: 18px; }
      .menu-foot a:hover { color: var(--paper); }
      @media (min-width: 1000px) {
        .menu-in { grid-template-columns: 1fr auto; }
        .menu-side { display: grid; align-content: center; }
        .menu-phone { width: min(300px, 22vw); transform: rotate(4deg) translateY(30px); opacity: 0; transition: transform 1s var(--out) 0.35s, opacity 0.6s 0.35s; }
        .menu.open .menu-phone { transform: rotate(4deg); opacity: 1; }
        .menu-foot { grid-column: 1 / -1; }
      }

    </style>

    <script>
      import "@/scripts/site/core";
    </script>
  </body>
</html>
