---
import SiteLayout from "@/layouts/SiteLayout.astro";
import { pricing, siteConfig } from "@/config/site";
import { faqs } from "@/components/site/content";
import Hero from "@/components/site/Hero.astro";
import Manifesto from "@/components/site/Manifesto.astro";
import Marquee from "@/components/site/Marquee.astro";
import Broll from "@/components/site/Broll.astro";
import Reference from "@/components/site/Reference.astro";
import Captions from "@/components/site/Captions.astro";
import Editor from "@/components/site/Editor.astro";
import Screens from "@/components/site/Screens.astro";
import Founder from "@/components/site/Founder.astro";
import Pricing from "@/components/site/Pricing.astro";
import Faq from "@/components/site/Faq.astro";
import Footer from "@/components/site/Footer.astro";

const organizationId = `${siteConfig.url}/#organization`;
const founderId = `${siteConfig.url}/#founder`;

const homepageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": organizationId,
      name: siteConfig.company,
      legalName: siteConfig.companyLegalName,
      description: siteConfig.companyDescription,
      url: siteConfig.url,
      logo: `${siteConfig.url}${siteConfig.logo}`,
      email: siteConfig.contactEmail,
      founder: { "@id": founderId },
      sameAs: [siteConfig.companyLinkedin, siteConfig.instagram, siteConfig.playStoreUrl],
      contactPoint: [
        { "@type": "ContactPoint", contactType: "customer support", email: siteConfig.supportEmail, availableLanguage: ["English", "Hindi"] },
        { "@type": "ContactPoint", contactType: "general enquiries", email: siteConfig.contactEmail, availableLanguage: ["English", "Hindi"] }
      ]
    },
    {
      "@type": "Person",
      "@id": founderId,
      name: siteConfig.founder.name,
      jobTitle: siteConfig.founder.title,
      email: siteConfig.founder.email,
      worksFor: { "@id": organizationId },
      sameAs: [siteConfig.founder.linkedin]
    },
    {
      "@type": "WebSite",
      "@id": `${siteConfig.url}/#website`,
      name: siteConfig.shortName,
      url: siteConfig.url,
      publisher: { "@id": organizationId },
      inLanguage: "en"
    },
    {
      "@type": "SoftwareApplication",
      name: siteConfig.shortName,
      applicationCategory: "MultimediaApplication",
      operatingSystem: "Android",
      description: siteConfig.description,
      url: siteConfig.playStoreUrl,
      downloadUrl: siteConfig.playStoreUrl,
      installUrl: siteConfig.playStoreUrl,
      publisher: { "@id": organizationId },
      author: { "@id": organizationId },
      offers: [
        {
          "@type": "Offer",
          name: "Free",
          price: "0",
          priceCurrency: "INR",
          description: `${pricing.welcomeCredits} free credits once per phone; editor and export free`,
          url: siteConfig.playStoreUrl
        },
        { "@type": "Offer", name: "Basic", price: "349", priceCurrency: "INR", description: `${pricing.basic.credits} credits a month`, url: siteConfig.playStoreUrl },
        { "@type": "Offer", name: "Pro", price: "1249", priceCurrency: "INR", description: "1000 credits a month", url: siteConfig.playStoreUrl },
        { "@type": "Offer", name: "Pro", price: "2499", priceCurrency: "INR", description: "2000 credits a month", url: siteConfig.playStoreUrl }
      ]
    },
    {
      "@type": "FAQPage",
      mainEntity: faqs.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: { "@type": "Answer", text: faq.answer }
      }))
    }
  ]
});
---

<SiteLayout
  title={`${siteConfig.shortName} | AI video editor for Android: B-roll, captions, reference edits`}
  description={siteConfig.description}
  jsonLd={homepageJsonLd}
  preload={["/media/site/hero_raw.webp"]}
>
  <main>
    <Hero />
    <Manifesto />
    <Marquee />
    <Broll />
    <Reference />
    <Captions />
    <Editor />
    <Screens />
    <Founder />
    <Pricing />
    <Faq />
  </main>
  <Footer />
</SiteLayout>
