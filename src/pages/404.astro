---
import SiteLayout from "@/layouts/SiteLayout.astro";
import Footer from "@/components/site/Footer.astro";
---

<SiteLayout
  loader={false}
  noindex
  title="Page Not Found — Zera Studio"
  description="The page you are looking for does not exist."
>
  <main class="nf">
    <div class="wrap nf-in">
      <h1 class="d nf-h">404</h1>
      <p class="lead nf-lead">
        The page you are looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="btn nf-btn" data-magnetic>
        Back to Zera Studio
      </a>
    </div>
  </main>

  <Footer />
</SiteLayout>

<style>
  .nf { min-height: 100svh; display: grid; align-items: center; padding: calc(var(--nav-h) + 40px) 0 40px; }
  .nf-in { display: grid; justify-items: center; text-align: center; gap: 26px; }
  .nf-h { font-size: clamp(160px, 34vw, 520px); color: var(--zera-hi); }
  .nf-lead { max-width: 34ch; }
  .nf-btn { margin-top: 6px; }
</style>
